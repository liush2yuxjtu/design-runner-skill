{
  "id": "ardot-remote",
  "label": "Tencent Design Ardot Remote MCP",
  "kind": "mcp",
  "endpoint": "https://ardot.tencent.com/mcp",
  "requirements": {
    "cloud": true,
    "desktopApp": false
  },
  "sources": [
    "https://docs.ardot.tencent.com/en/ardot-mcp/introduction",
    "https://docs.ardot.tencent.com/en/ardot-mcp/remote-mcp.html",
    "https://docs.ardot.tencent.com/en/ardot-mcp/permissions-billing.html"
  ],
  "verifiedAgainst": {
    "mcpServerVersion": "1.0.13-77dcb896",
    "toolCount": 25,
    "verifiedAt": "2026-08-27"
  },
  "notes": "GUI-free after one-time browser OAuth, but all documents and tool calls use Ardot Cloud. Verified through the Pi design-mcp extension.",
  "operations": {
    "file.create": {
      "kind": "tool",
      "candidates": ["create_design"],
      "writesDesign": true
    },
    "document.inspect": {
      "kind": "tool",
      "candidates": ["fetch_file_info", "fetch_editor_state", "batch_read", "capture_layout", "fetch_guidelines"],
      "writesDesign": false
    },
    "canvas.execute": {
      "kind": "tool",
      "candidates": ["locate_available_space", "batch_edit"],
      "writesDesign": true
    },
    "render.capture": {
      "kind": "tool",
      "candidates": ["capture_screenshot"],
      "writesDesign": false
    },
    "asset.import": {
      "kind": "tool",
      "candidates": ["register_assets", "upload_images", "html_to_ardot"],
      "writesDesign": true
    },
    "asset.export": {
      "kind": "tool",
      "candidates": ["scan_exportable_resources", "export_nodes"],
      "writesDesign": false
    },
    "token.read": {
      "kind": "tool",
      "candidates": ["fetch_variables", "export_variables"],
      "writesDesign": false
    },
    "token.write": {
      "kind": "tool",
      "candidates": ["apply_variables"],
      "writesDesign": true
    },
    "component.read": {
      "kind": "tool",
      "candidates": ["fetch_component_lib", "batch_read"],
      "writesDesign": false
    },
    "component.write": {
      "kind": "tool",
      "candidates": ["batch_edit"],
      "writesDesign": true
    },
    "component.map": {
      "kind": "emulated",
      "candidates": ["fetch_component_lib", "batch_read"],
      "writesDesign": false,
      "notes": "No native Code Connect-style mapping tool was exposed. Keep mappings in local code or Storybook."
    },
    "diagram.create": {
      "kind": "emulated",
      "candidates": ["batch_edit", "capture_screenshot"],
      "writesDesign": true,
      "notes": "Build named canvas primitives; no native diagram generator was exposed."
    },
    "whiteboard.edit": {
      "kind": "emulated",
      "candidates": ["batch_edit", "capture_screenshot"],
      "writesDesign": true,
      "notes": "Emulate a planning board with canvas primitives. This is not a native FigJam mode."
    },
    "slides.edit": {
      "kind": "emulated",
      "candidates": ["batch_edit", "capture_screenshot", "export_nodes"],
      "writesDesign": true,
      "notes": "Lay out slide frames and export PPTX through export_nodes; no dedicated slide-authoring MCP tool was exposed."
    },
    "motion.read": {
      "kind": "unsupported",
      "candidates": [],
      "writesDesign": false,
      "notes": "The verified Remote MCP catalog exposed no motion or prototype-context tool."
    },
    "motion.write": {
      "kind": "unsupported",
      "candidates": [],
      "writesDesign": true,
      "notes": "The verified Remote MCP catalog exposed no motion or prototype-write tool."
    }
  }
}
